{
  "name": "jev-adblock",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.mjs",
    "serve": "node scripts/serve.mjs",
    "test:site": "node tests/live-site.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run build && python3 scripts/package.py"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "prettier": "3.6.2"
  },
  "license": "MIT",
  "description": "Privacy-conscious Chrome extension for Jev-powered ad classification and reversible DOM removal",
  "engines": {
    "node": ">=20"
  }
}
